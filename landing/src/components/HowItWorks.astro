---
import CopyCommand from "@/islands/CopyCommand";
import { steps } from "@/data/otto";
---

<section id="how" class="mx-auto max-w-6xl px-4 py-28">
  <h2 class="reveal max-w-2xl font-display text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
    Three steps from download to first answer.
  </h2>
  <ol class="mt-14 grid gap-4 lg:grid-cols-3">
    {
      steps.map((step, index) => (
        <li class="spotlight reveal rounded-3xl border border-otto-line bg-otto-surface p-6 sm:p-8">
          <span class="font-mono text-sm text-otto-muted">0{index + 1}</span>
          <h3 class="mt-6 font-display text-2xl font-semibold tracking-tight">{step.title}</h3>
          <p class="mt-3 leading-relaxed text-otto-muted">{step.body}</p>
          {step.commands.length > 0 && (
            <div class="mt-6 space-y-2.5">
              {step.commands.map((command) => (
                <CopyCommand command={command} client:visible />
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ol>
</section>
