---
import TopBanner from "@/islands/TopBanner";
import { releaseUrl } from "@/data/otto";

const links = [
  { href: "#features", label: "Features" },
  { href: "#modes", label: "Modes" },
  { href: "#control", label: "Privacy" },
  { href: "#how", label: "How it works" },
  { href: "#faq", label: "FAQ" },
];
---

<TopBanner client:load />
<header class="sticky top-0 z-50">
  <nav class="nav-bar backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4">
      <a href="#top" class="flex items-center gap-2.5 font-display text-[17px] font-semibold tracking-tight">
        <img src="/otto-icon.png" alt="" width="28" height="28" class="size-7 rounded-full ring-1 ring-otto-line" />
        Otto
      </a>
      <div class="hidden items-center gap-7 text-sm text-otto-muted md:flex">
        {links.map((link) => (
          <a href={link.href} class="transition hover:text-otto-text">{link.label}</a>
        ))}
      </div>
      <a href={releaseUrl} class="inline-flex h-9 items-center rounded-full bg-otto-text px-4 text-sm font-medium text-otto-bg transition hover:bg-white">Download</a>
    </div>
  </nav>
</header>
