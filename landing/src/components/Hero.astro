---
import NotchDemo from "@/islands/NotchDemo";
import RotatingWord from "@/islands/RotatingWord";
import { releaseUrl } from "@/data/otto";
---

<section id="top" class="relative isolate overflow-hidden px-4 pb-24 pt-16 sm:pt-24">
  <div aria-hidden="true" class="grid-fade absolute inset-0 -z-10"></div>
  <div aria-hidden="true" class="glow absolute left-1/2 top-0 -z-10 h-[640px] w-[min(1000px,150vw)] -translate-x-1/2 -translate-y-1/3 rounded-full"></div>
  <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1fr_1.05fr] lg:gap-12">
    <div>
      <p class="rise inline-flex items-center gap-2 rounded-full border border-otto-line bg-otto-surface/70 px-3 py-1 text-xs text-otto-muted">
        <span class="size-1.5 rounded-full bg-otto-sage"></span>
        Otto 1.0.0 for Windows 11
      </p>
      <h1 class="rise mt-6 font-display text-[2.6rem] leading-[1.02] font-semibold tracking-[-0.03em] text-balance sm:text-6xl lg:text-[4rem]" style="--delay: 80ms">
        The AI mentor that lives at the top of your screen.
      </h1>
      <p class="rise mt-6 font-display text-xl text-otto-body sm:text-2xl" style="--delay: 160ms">
        Built for when you <RotatingWord client:load />.
      </p>
      <p class="rise mt-5 max-w-xl text-base leading-relaxed text-otto-muted sm:text-lg" style="--delay: 220ms">
        Otto is a quiet Windows notch for studying, reading, and solving hard problems. It runs on the AI command-line tools you already use, so there are no new API keys, no extra subscription, and no separate AI app to open.
      </p>
      <div class="rise mt-9 flex flex-wrap gap-3" style="--delay: 300ms">
        <a href={releaseUrl} class="btn-primary">Download for Windows</a>
        <a href="#how" class="btn-secondary">See how it works</a>
      </div>
      <p class="rise mt-4 text-xs text-otto-muted" style="--delay: 360ms">Installs for your Windows user account, no admin prompt.</p>
    </div>
    <div class="rise" style="--delay: 240ms">
      <NotchDemo client:load />
    </div>
  </div>
</section>
