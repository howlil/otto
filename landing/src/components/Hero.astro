---
import NotchDemo from "@/islands/NotchDemo";
import RotatingWord from "@/islands/RotatingWord";
import { changelogUrl, releaseUrl } from "@/data/otto";
---

<section id="top" class="relative isolate overflow-hidden">
  <div aria-hidden="true" class="grid-fade absolute inset-0 -z-10"></div>
  <div aria-hidden="true" class="glow absolute left-1/2 top-0 -z-10 h-[560px] w-[min(960px,150vw)] -translate-x-1/2 -translate-y-1/3 rounded-full"></div>
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-14 px-4 pb-20 pt-28 sm:pt-32 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:pb-28 lg:pt-36">
    <div>
      <a href={changelogUrl} class="rise inline-flex items-center gap-2 rounded-full border border-otto-line bg-otto-surface/70 px-3 py-1 text-xs text-otto-muted transition hover:text-otto-text">
        <span class="size-1.5 rounded-full bg-otto-ok"></span>
        Coming in 1.4.0: Circle, local voice, Read Aloud
      </a>
      <h1 class="rise mt-6 font-display text-[2.6rem] leading-[1.02] font-semibold tracking-[-0.03em] text-balance sm:text-6xl lg:text-[4rem]" style="--delay: 80ms">
        The AI mentor that lives at the top of your screen.
      </h1>
      <p class="rise mt-6 font-display text-xl text-otto-body sm:text-2xl" style="--delay: 160ms">
        Otto helps you <span class="inline-block"><RotatingWord client:load /></span> without leaving the page you are on.
      </p>
      <div class="rise mt-9 flex flex-wrap gap-3" style="--delay: 240ms">
        <a href={releaseUrl} class="btn-primary">Download for Windows</a>
        <a href="#story" class="btn-secondary">See how it works</a>
      </div>
      <p class="rise mt-4 text-xs text-otto-muted" style="--delay: 300ms">Installs for your Windows user account, no admin prompt.</p>
    </div>
    <figure class="rise" style="--delay: 200ms">
      <div class="relative flex min-h-[300px] items-start justify-center overflow-hidden rounded-3xl border border-otto-line bg-otto-bg px-3 pt-8 sm:min-h-[360px] sm:px-6 sm:pt-10">
        <div aria-hidden="true" class="grid-fade absolute inset-0"></div>
        <div class="relative w-full">
          <NotchDemo client:load />
        </div>
      </div>
      <figcaption class="mt-3 text-center text-xs text-otto-muted">Live preview. Press Ctrl Alt O to fold the notch.</figcaption>
    </figure>
  </div>
</section>
