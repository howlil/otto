---
import { shortcuts } from "@/data/otto";
---

<section id="shortcuts" class="mx-auto max-w-4xl px-4 py-28">
  <h2 class="reveal font-display text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Keyboard first.</h2>
  <ul class="reveal mt-12 divide-y divide-otto-line-soft overflow-hidden rounded-3xl border border-otto-line bg-otto-surface">
    {shortcuts.map((shortcut) => (
      <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-6">
        <span class="text-sm text-otto-body">{shortcut.action}</span>
        <span class="flex flex-none items-center gap-1.5">
          {shortcut.keys.map((key) => (
            <kbd class="rounded-otto-chip border border-otto-line-mid bg-otto-raised-soft px-2 py-1 font-mono text-[11px] text-otto-text-secondary">{key}</kbd>
          ))}
        </span>
      </li>
    ))}
  </ul>
</section>
