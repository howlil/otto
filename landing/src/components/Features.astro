---
import ModelSwitch from "@/islands/ModelSwitch";
import BackgroundDemo from "@/islands/BackgroundDemo";
import { alsoIncluded } from "@/data/otto";
---

<section id="features" class="mx-auto max-w-6xl px-4 py-28">
  <h2 class="reveal max-w-2xl font-display text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
    Switch engines, change the look, keep the answer.
  </h2>
  <div class="mt-14 grid grid-cols-1 gap-4 lg:grid-cols-5">
    <article class="reveal rounded-3xl border border-otto-line bg-otto-surface p-6 sm:p-8 lg:col-span-2 lg:row-span-2">
      <p class="font-mono text-xs text-otto-muted">Ctrl M</p>
      <h3 class="mt-3 font-display text-2xl font-semibold tracking-tight">Engine and model, one key away.</h3>
      <div class="mt-8">
        <ModelSwitch client:visible />
      </div>
    </article>
    <article class="reveal rounded-3xl border border-otto-line bg-otto-surface p-6 sm:p-8 lg:col-span-3">
      <h3 class="font-display text-2xl font-semibold tracking-tight">Solid, or see-through.</h3>
      <div class="mt-6">
        <BackgroundDemo client:visible />
      </div>
    </article>
    <article class="reveal rounded-3xl border border-otto-line bg-otto-surface p-6 sm:p-8 lg:col-span-3">
      <h3 class="font-display text-2xl font-semibold tracking-tight">Answers keep their shape.</h3>
      <pre class="mt-6 overflow-x-auto rounded-otto-panel border border-otto-line-soft bg-otto-bg p-4 font-mono text-[12px] leading-[1.7] text-otto-text-secondary"><code><span class="text-otto-hljs-keyword">def</span> <span class="text-otto-hljs-function">slope</span>(f, x, h=<span class="text-otto-hljs-number">1e-6</span>):
    <span class="text-otto-hljs-keyword">return</span> (f(x + h) - f(x)) / h</code></pre>
      <table class="mt-5 w-full border-collapse text-left text-otto-xs">
        <thead>
          <tr class="border-b border-otto-line-soft text-otto-text-tertiary">
            <th class="py-2 pr-4 font-medium">Mode</th>
            <th class="py-2 font-medium">Best for</th>
          </tr>
        </thead>
        <tbody class="text-otto-text-secondary">
          <tr class="border-b border-otto-line-soft">
            <td class="py-2 pr-4">Solve</td>
            <td class="py-2">Verified math and logic</td>
          </tr>
          <tr class="border-b border-otto-line-soft">
            <td class="py-2 pr-4">Mentor</td>
            <td class="py-2">Guided steps with questions</td>
          </tr>
          <tr>
            <td class="py-2 pr-4">Practice</td>
            <td class="py-2">Short recall drills</td>
          </tr>
        </tbody>
      </table>
      <p class="mt-5 font-mono text-sm text-otto-text">f′(x) = lim<sub>h→0</sub> (f(x + h) − f(x)) / h</p>
    </article>
    <article class="reveal flex flex-col justify-between rounded-3xl border border-otto-line bg-otto-surface p-6 sm:p-8 lg:col-span-3">
      <h3 class="font-display text-2xl font-semibold tracking-tight">Also included</h3>
      <ul class="mt-6 flex flex-wrap gap-2">
        {alsoIncluded.map((item) => (
          <li class="rounded-full border border-otto-line-soft bg-otto-control px-3 py-1.5 text-sm text-otto-body">{item}</li>
        ))}
      </ul>
    </article>
  </div>
</section>
