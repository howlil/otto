---
import { releaseUrl, repoUrl } from "@/data/otto";
---

<section class="mx-auto max-w-6xl px-4 pb-28 pt-12">
  <div class="reveal relative overflow-hidden rounded-[32px] border border-otto-line bg-otto-surface px-6 py-16 text-center sm:px-16 sm:py-24">
    <div aria-hidden="true" class="glow absolute left-1/2 top-0 h-[420px] w-[min(760px,120vw)] -translate-x-1/2 -translate-y-1/2 rounded-full"></div>
    <h2 class="relative font-display text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
      Your next question, answered where you are.
    </h2>
    <p class="relative mx-auto mt-6 max-w-xl text-lg leading-relaxed text-otto-muted">
      Install Otto, sign in to the AI tool you already use, and press Ctrl+Alt+O the next time you get stuck.
    </p>
    <div class="relative mt-10 flex flex-wrap items-center justify-center gap-3">
      <a href={releaseUrl} class="btn-primary">Download for Windows</a>
      <a href={repoUrl} class="btn-secondary">View on GitHub</a>
    </div>
    <p class="relative mt-6 text-xs text-otto-muted">Windows 11 · Installs for your user account · Updates are minisign-verified</p>
  </div>
</section>
