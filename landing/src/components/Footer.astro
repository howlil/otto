---
import { changelogUrl, releasesUrl, repoUrl } from "@/data/otto";
---

<footer class="border-t border-otto-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 text-sm text-otto-muted sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-2.5 text-otto-body">
      <img src="/otto-icon.png" alt="" width="24" height="24" class="size-6 rounded-full ring-1 ring-otto-line" />
      <span>Otto · Windows 11</span>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-6">
      <a href={releasesUrl} class="transition hover:text-otto-text">Releases</a>
      <a href={changelogUrl} class="transition hover:text-otto-text">Changelog</a>
      <a href={repoUrl} class="transition hover:text-otto-text">GitHub</a>
    </nav>
    <p>Built with Tauri 2, Rust, and React 19.</p>
  </div>
</footer>
